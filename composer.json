{
    "name": "kanvigo/audit-contracts",
    "description": "Stable contracts for Kanvigo's pluggable audit layer: the immutable AuditEvent DTO and the AuditSink interface third-party sinks implement.",
    "keywords": ["kanvigo", "audit", "audit-log", "contracts", "compliance"],
    "homepage": "https://github.com/Fanmade/audit-contracts",
    "license": "MIT",
    "version": "0.1.0",
    "authors": [
        {
            "name": "Ben",
            "email": "dev@reuterben.de"
        }
    ],
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Kanvigo\\Audit\\Contracts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kanvigo\\Audit\\Contracts\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": ["pint"],
        "test": ["pest"]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
